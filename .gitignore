# Third-party ROM images.  Not ours to redistribute, and an injected build's
# testipl.dat embeds the whole IPL it was injected into.
exbios/
build-exbios/
test/build_inj_*/

# MAME rompaths staged by the test scripts.  Each zip holds the full Sharp set.
test/roms/
test/roms_*/

# Build output.  bin/ is the exception: committed on purpose so a ROM can be
# burned without installing an assembler.
build/

# vasm, fetched and compiled by get-vasm.sh.
tools/

# MAME scratch, created wherever you run it from.
**/nvram/
**/cfg/
**/snap/

__pycache__/

# Local notes for coding agents.
CLAUDE.md

# Editor and OS noise.  ._* are macOS AppleDouble resource forks.
._*
.DS_Store
*~
*.bak
*.orig
*.rej
