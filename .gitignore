# Third-party ROM images.  Not ours to redistribute, and an injected build's
# ipl_post.dat embeds the whole IPL it was injected into -- so build-exbios/
# and test/build_inj_*/ hold derivative ROM images, not clean output.
exbios/
build-exbios/
test/build_inj_*/

# MAME rompaths.  Every one of these zips contains the full Sharp ROM set:
# cgrom.dat, iplrom*.dat, the ic11/ic12 halves and the SCSI ROMs.
mame-roms/
mame-roms-diag/
test/roms/
test/roms_*/

# Build output, all regenerated by build.py.  bin/ is the exception: those are
# committed on purpose so a ROM can be burned without installing an assembler.
build/
build-diag/

# vasm, fetched and compiled by get-vasm.sh.  A binary for one architecture.
tools/

# MAME scratch, created wherever you run it from.
**/nvram/
**/cfg/
**/snap/

__pycache__/

# Editor and OS noise.  ._* are macOS AppleDouble resource forks, which this
# tree is full of after a round trip through a Mac.
._*
.DS_Store
*~
*.bak
*.orig
*.rej

# Held back from the public repo for now: a personal bench checklist with
# stale md5s and a lab log about one specific machine.  Needs rewriting for a
# general reader before it ships.
BURN-PRO.md
